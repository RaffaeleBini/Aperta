# Copia questo file in .env (mai committato — vedi .gitignore) e valorizza
# solo le variabili che ti servono per l'ambiente in cui lavori.

# Sentry — error tracking (vedi sezione "Monitoraggio" del README)
# Lo stesso DSN in entrambe: non è un segreto (è pensato per essere pubblico),
# ma NEXT_PUBLIC_SENTRY_DSN serve al codice lato client, SENTRY_DSN a quello server.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# I secret di deploy (token Railway, credenziali upload sourcemap Sentry)
# NON vanno qui: vivono come GitHub Actions Secrets, mai nel repository.
